{
	"schemaVersion": 1,
	"id": "hearthbound-colonies",
	"version": "${version}",
	"name": "Hearthbound Colonies",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/hearthbound-colonies/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "dev.minecraft.hearthbound.HearthboundColonies",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "dev.minecraft.hearthbound.client.HearthboundColoniesClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"hearthbound-colonies.mixins.json",
		{
			"config": "hearthbound-colonies.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}